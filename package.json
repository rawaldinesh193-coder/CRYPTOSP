{
  "name": "cryptosp-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "CRYPTOSP Full-Stack Digital Wallet & Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "dev:admin": "npm run dev -w apps/admin",
    "build:api": "npm run build -w apps/api",
    "build:web": "npm run build -w apps/web",
    "build:admin": "npm run build -w apps/admin",
    "build": "npm run build:api && npm run build:web && npm run build:admin",
    "db:push": "npm run db:push -w packages/database",
    "db:studio": "npm run db:studio -w packages/database"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.4"
  }
}
